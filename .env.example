# Copy to .env for local development. Values here match compose.yaml and
# infra/keycloak/realm-daily.json and are for localhost only.

DATABASE_URL="postgres://daily:daily-dev-password@localhost:5433/daily"

# Keycloak realm "daily" (http://localhost:8080 in development)
KEYCLOAK_ISSUER="http://localhost:8080/realms/daily"
KEYCLOAK_CLIENT_ID="daily-web"
KEYCLOAK_CLIENT_SECRET="daily-web-dev-secret"

# Public origin of this app; used to build OIDC redirect URIs.
APP_ORIGIN="http://localhost:5174"
