# Static public preview: `pnpm build:static` (vite --mode static).
# No secrets here. The preview has no database and no sign-in; the server
# values below only satisfy env validation while prerendering and are never
# used to connect anywhere. CI overrides PUBLIC_BASE_PATH (e.g. /daily).
PUBLIC_PREVIEW=1
PUBLIC_BASE_PATH=
DATABASE_URL=postgres://preview:preview@127.0.0.1:1/preview
KEYCLOAK_ISSUER=https://preview.invalid/realms/daily
KEYCLOAK_CLIENT_ID=preview
KEYCLOAK_CLIENT_SECRET=preview
APP_ORIGIN=https://preview.invalid
