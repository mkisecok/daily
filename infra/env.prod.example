# Copy to /opt/daily/.env on the server (chmod 600). Fill every value with a
# new random secret, e.g. `openssl rand -base64 32`. Never reuse the
# development values from compose.yaml or infra/keycloak/realm-daily.json.

# Postgres (app and Keycloak databases)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://daily:<POSTGRES_PASSWORD>@postgres:5432/daily

# Keycloak client "daily-web"; the realm import reads the same value
KEYCLOAK_CLIENT_ID=daily-web
KEYCLOAK_CLIENT_SECRET=

# first start only: create a personal admin with OTP in the master realm,
# then remove these two lines and restart Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# outgoing mail for verification and password reset (a provider in the EU)
KC_SMTP_HOST=
KC_SMTP_PORT=587
KC_SMTP_FROM=no-reply@dai-ly.de
KC_SMTP_USER=
KC_SMTP_PASSWORD=

# addresses allowed to open https://auth.dai-ly.de/admin, e.g. 203.0.113.7/32
KC_ADMIN_ALLOW=

# Let's Encrypt account e-mail
ACME_EMAIL=

# image tag to run; deploy.sh uses `main` when unset
DAILY_TAG=main
